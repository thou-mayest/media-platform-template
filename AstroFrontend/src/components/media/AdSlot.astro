---
interface Props {
  /** Reserved box shape. Must match the surrounding cells exactly. */
  ratio?: string;
}
const { ratio = '3 / 4' } = Astro.props;
---

<div class="adcard" style={`aspect-ratio:${ratio};`} role="complementary" aria-label="Advertisement">
  <span class="adlabel">Sponsored</span>
  <span class="adnote">Ad slot</span>
</div>

<style>
  .adcard {
    border-radius: var(--radius-lg);
    border: 1.5px dashed var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    padding: 14px;
  }
  .adlabel {
    font: 600 11px var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .adnote {
    font: 600 9px ui-monospace, Menlo, monospace;
    color: var(--faint);
  }
</style>