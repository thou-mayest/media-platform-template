---
export type Crumb = { label: string; href?: string };

interface Props { items: Crumb[]; }
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>
        {c.href ? <a href={c.href}>{c.label}</a> : <span class="crumb-cur" aria-current="page">{c.label}</span>}
        {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { padding: 4px 0 18px; font-size: 13px; color: var(--muted); }
  .crumbs ol {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    list-style: none; margin: 0; padding: 0;
  }
  .crumbs li { display: inline-flex; align-items: center; gap: 8px; }
  .crumbs a:hover { color: var(--accent); }
  .crumb-cur { color: var(--text); }
  .sep { color: var(--faint); }
</style>