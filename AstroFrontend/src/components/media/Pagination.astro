---
interface Props {
  page: number;
  totalPages: number;
  hasPrev: boolean;
  hasNext: boolean;
  /** Built by lib/routes so page 1 never carries ?page=1. */
  hrefFor: (page: number) => string;
  label?: string;
}

const { page, totalPages, hasPrev, hasNext, hrefFor, label = 'Pagination' } =
  Astro.props;

/** First, last, and the current page ±1, with gaps elsewhere. */
function windowed(current: number, total: number): (number | 'gap')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

  const out: (number | 'gap')[] = [1];
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  if (start > 2) out.push('gap');
  for (let i = start; i <= end; i += 1) out.push(i);
  if (end < total - 1) out.push('gap');

  out.push(total);
  return out;
}

const items = windowed(page, totalPages);
---

{totalPages > 1 && (
  <nav class="pagerbar" aria-label={label}>
    <div class="pager">
      {hasPrev
        ? <a class="pg pg--prev" href={hrefFor(page - 1)} rel="prev">← Previous</a>
        : <span class="pg pg--prev pg--off" aria-hidden="true">← Previous</span>}

      {items.map((it) =>
        it === 'gap' ? (
          <span class="pg pg-ell" aria-hidden="true">…</span>
        ) : it === page ? (
          <span class="pg pg--cur" aria-current="page">{it}</span>
        ) : (
          <a class="pg" href={hrefFor(it)} aria-label={`Page ${it}`}>{it}</a>
        ),
      )}

      {hasNext
        ? <a class="pg pg--next" href={hrefFor(page + 1)} rel="next">Next →</a>
        : <span class="pg pg--next pg--off" aria-hidden="true">Next →</span>}
    </div>

    <p class="pager__status">Page {page} of {totalPages}</p>
  </nav>
)}

<style>
  .pagerbar {
    margin: 60px 8px 0;
    padding: 30px 0 2px;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .pager {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .pg {
    min-width: 38px;
    height: 38px;
    padding: 0 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    font-size: 14px;
    color: var(--text-2);
    border: 1px solid var(--border-soft);
    background: var(--bg);
  }
  a.pg:hover { border-color: var(--border); color: var(--text); }
  a.pg:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .pg--cur {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
  }
  .pg--prev,
  .pg--next { padding: 0 15px; font-weight: 600; color: var(--text); }
  .pg--off { opacity: 0.4; pointer-events: none; }
  .pg-ell { color: var(--faint); padding: 0 2px; border: none; min-width: auto; background: none; }

  .pager__status {
    margin: 0;
    font-size: 12.5px;
    color: var(--muted);
  }
</style>