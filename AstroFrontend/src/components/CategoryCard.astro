---
interface Props {
  name: string;
  count: number;
  bg: string;
  slug: string;
  size?: 'sm' | 'lg';
  showWorksSuffix?: boolean;
}

const { name, count, bg, slug, size = 'sm', showWorksSuffix = false } = Astro.props;
const aspect = size === 'lg' ? '1.3' : '1.45';
const titleSize = size === 'lg' ? 21 : 20;
---

<a class="cat-card" href={`/categories/${slug}`}>
  <div class="cat-card__art" style={`background:${bg};aspect-ratio:${aspect};`}></div>
  <div class="cat-card__row">
    <span class="cat-card__name" style={`font-size:${titleSize}px;`}>{name}</span>
    <span class="cat-card__count">{count}{showWorksSuffix ? ' works' : ''}</span>
  </div>
</a>

<style>
  .cat-card {
    cursor: pointer;
    display: block;
    transition: opacity 0.25s;
  }
  .cat-card:hover {
    opacity: 0.86;
  }
  .cat-card__art {
    width: 100%;
    border: 1px solid var(--hairline);
    border-radius: 18px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  .cat-card:hover .cat-card__art {
    transform: translateY(-2px);
  }
  .cat-card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 12px;
  }
  .cat-card__name {
    font-family: 'Spectral', serif;
    color: var(--text);
  }
  .cat-card__count {
    font-size: 11px;
    font-weight: 500;
    color: var(--faint);
  }
</style>
