---
// Presentation component of the Favorites module.
//
// A bookmark icon that toggles a post's saved state. The viewer's choice
// persists in localStorage (key `verso:favorites`, same anonymous mechanism
// as reactions/comments/follow/save). Self-contained — the page only has to
// render <FavoriteButton postId={...} />.

import { isFavorite } from '@/data/favorites';

interface Props {
  postId: number;
}

const { postId } = Astro.props;
const active = isFavorite(postId);
---

<button
  class:list={['fav-btn', { 'is-active': active }]}
  type="button"
  data-favorite-toggle
  data-post-id={postId}
  aria-pressed={active}
  aria-label={active ? 'Remove from saved' : 'Save this post'}
  title={active ? 'Saved' : 'Save'}
>
  <svg class="fav-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
    <path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z" />
  </svg>
</button>

<script>
  import { toggleFavorite } from '@/data/favorites';

  document.querySelectorAll<HTMLElement>('[data-favorite-toggle]').forEach((btn) => {
    const postId = Number(btn.dataset.postId);
    if (!Number.isInteger(postId)) return;

    const sync = () => {
      const active = toggleFavorite(postId);
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
      btn.setAttribute('aria-label', active ? 'Remove from saved' : 'Save this post');
      btn.setAttribute('title', active ? 'Saved' : 'Save');
    };

    // Paint from store on mount (handles page reload).
    const stored = btn.classList.contains('is-active');
    sync();
    // sync toggled it — if it was active, sync set it to inactive. Restore.
    if (stored) sync();
  });
</script>

<style>
  .fav-btn {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--text-2);
    transition: background 0.18s, color 0.18s, border-color 0.18s, transform 0.12s;
    flex: none;
  }
  .fav-btn:hover {
    border-color: var(--border);
    color: var(--accent);
  }
  .fav-btn.is-active {
    background: var(--ink);
    color: var(--accent);
    border-color: var(--ink);
  }
  .fav-btn.is-active .fav-icon {
    fill: var(--accent);
  }
  .fav-btn:not(:disabled):active {
    transform: scale(0.92);
  }
  .fav-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .fav-icon {
    flex: none;
  }
</style>