---
interface Props {
  initialQ?: string;
}
const { initialQ = '' } = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/explore', label: 'Explore' },
  { href: '/artists', label: 'Artists' },
  { href: '/categories', label: 'Categories' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">VERSO</a>
    <nav class="nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={pathname.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <form class="search" role="search" action="/search" method="get" data-search-form>
      <svg class="search__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M21 21l-4.3-4.3"></path>
      </svg>
      <input
        type="search"
        name="q"
        value={initialQ}
        placeholder="Search artists, works, tags"
        autocomplete="off"
      />
    </form>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-soft);
  }
  .site-header__inner {
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
    padding: 11px 0;
  }
  .brand {
    font-family: 'Spectral', serif;
    font-weight: 600;
    font-size: 23px;
    letter-spacing: 0.03em;
    color: var(--text);
  }
  .nav {
    display: flex;
    gap: 22px;
    align-items: center;
  }
  .nav a {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--text);
    transition: color 0.2s;
  }
  .nav a:hover {
    color: var(--accent);
  }
  .nav a[aria-current='page'] {
    color: var(--accent);
  }
  .search {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 9px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 5px;
    min-width: 180px;
    flex: 0 1 300px;
    color: var(--muted);
  }
  .search input {
    border: none;
    background: transparent;
    outline: none;
    font-size: 14px;
    font-family: 'Archivo', system-ui, sans-serif;
    color: var(--text);
    width: 100%;
  }
  .search__icon {
    flex-shrink: 0;
  }

</style>
