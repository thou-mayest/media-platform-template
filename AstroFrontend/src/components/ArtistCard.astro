---
import type { Artist } from '@/data/gallery';
import { artworksByArtist } from '@/data/gallery';

interface Props {
  artist: Artist;
  full?: boolean;
}

const { artist, full = true } = Astro.props;
const works = artworksByArtist(artist.id);
const sample = works.slice(0, 3);
---

<a class="artist-card" href={`/artists/${artist.slug}`}>
  <div class="artist-card__grid">
    {sample.map((s) => <div class="artist-card__cell" style={`background:${s.bg};`}></div>)}
    {sample.length < 3 && Array.from({ length: 3 - sample.length }).map(() => <div class="artist-card__cell artist-card__cell--empty"></div>)}
  </div>
  <div class="artist-card__head">
    <span class="artist-card__name">{artist.name}</span>
    <span class="artist-card__count">{works.length} works</span>
  </div>
  <div class="artist-card__loc">{artist.location}</div>
  {full && <div class="artist-card__disc">{artist.disciplines}</div>}
</a>

<style>
  .artist-card {
    cursor: pointer;
    display: block;
    transition: opacity 0.2s;
  }
  .artist-card:hover {
    opacity: 0.92;
  }
  .artist-card__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .artist-card__cell {
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--hairline);
  }
  .artist-card__cell--empty {
    background: var(--surface);
  }
  .artist-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 15px;
    gap: 10px;
  }
  .artist-card__name {
    font-family: 'Spectral', serif;
    font-size: 23px;
    line-height: 1.1;
    color: var(--text);
  }
  .artist-card__count {
    font-size: 11px;
    color: var(--faint);
    white-space: nowrap;
  }
  .artist-card__loc {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 7px;
  }
  .artist-card__disc {
    font-size: 13px;
    color: var(--muted);
    margin-top: 4px;
  }
</style>
