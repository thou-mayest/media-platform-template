---
import Layout from '@/layouts/Layout.astro';
import { getPosts, getPostFacets } from '@/lib/server/posts';
import type { PostSummary, PostFacet } from '@/lib/server/posts';

let posts: PostSummary[] = [];
let categories: PostFacet[] = [];

try {
  const [postsRes, facets] = await Promise.all([
    getPosts({ pageSize: 100 }).catch(() => ({ items: [], page: 1, pageSize: 100, totalCount: 0, totalPages: 0 })),
    getPostFacets().catch(() => ({ categories: [], tags: [] })),
  ]);
  posts = postsRes.items || [];
  categories = facets.categories || [];
} catch {
  posts = [];
  categories = [];
}

const totalPosts = posts.length;
const publishedCount = posts.filter((p) => (p.status || '').toLowerCase() === 'published').length;
const draftCount = posts.filter((p) => (p.status || '').toLowerCase() === 'draft').length;
---

<Layout
  title="Posts & Editorial Directory — Verso Back Office"
  description="Manage, inspect, and publish visual works and editorial posts."
>
  <main class="container page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/admin">Back Office</a>
      <span class="sep">/</span>
      <span class="current">Posts</span>
    </nav>

    <!-- Page Header with Primary Action -->
    <header class="page-header">
      <div>
        <div class="eyebrow">Back Office · Editorial</div>
        <h1 class="h-display page__h1">Posts Directory</h1>
        <p class="page__lede">
          Catalog of all visual media posts, drafts, and published works across the platform.
        </p>
      </div>

      <div class="page-header__actions">
        <a href="/admin/posts/new" class="btn btn--primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-inline">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
          Create New Post
        </a>
      </div>
    </header>

    <!-- Stats Banner -->
    <section class="stats-grid">
      <div class="stat-card">
        <span class="stat-card__label">Total Posts</span>
        <span class="stat-card__val" id="statTotal">{totalPosts}</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__label">Published Works</span>
        <span class="stat-card__val stat-card__val--published" id="statPublished">{publishedCount}</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__label">Drafts</span>
        <span class="stat-card__val stat-card__val--draft" id="statDrafts">{draftCount}</span>
      </div>
    </section>

    <!-- Filter & Search Toolbar -->
    <section class="toolbar">
      <div class="search-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="search-icon">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="search"
          id="postSearchInput"
          placeholder="Search by title, description or tag..."
        />
      </div>

      <div class="toolbar__filters">
        <select id="categoryFilter" aria-label="Filter by category">
          <option value="">All Categories</option>
          {categories.map((c: PostFacet) => (
            <option value={c.name}>{c.name}</option>
          ))}
        </select>

        <select id="statusFilter" aria-label="Filter by status">
          <option value="">All Statuses</option>
          <option value="Published">Published</option>
          <option value="Draft">Draft</option>
        </select>
      </div>
    </section>

    <!-- Table of Posts -->
    <section class="panel">
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 70px;">Media</th>
              <th>Title & Overview</th>
              <th>Category</th>
              <th>Tags</th>
              <th>Status</th>
              <th>Date</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody id="postsTableBody">
            {posts.map((post) => {
              const isPublished = (post.status || '').toLowerCase() === 'published';
              return (
                <tr
                  class="post-row"
                  data-id={post.id}
                  data-title={(post.title || '').toLowerCase()}
                  data-category={post.category || ''}
                  data-status={post.status || ''}
                  data-tags={(post.tags || []).join(' ').toLowerCase()}
                >
                  <td>
                    <div class="thumb-cell">
                      {post.mediaUrl ? (
                        <img src={post.mediaUrl} alt={post.title} class="thumb-img" />
                      ) : (
                        <div class="thumb-placeholder">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                            <circle cx="8.5" cy="8.5" r="1.5" />
                            <polyline points="21 15 16 10 5 21" />
                          </svg>
                        </div>
                      )}
                    </div>
                  </td>
                  <td>
                    <div class="post-title-cell">
                      <a href={`/posts/${post.id}`} class="post-title-link">
                        {post.title}
                      </a>
                      <p class="post-desc-excerpt">{post.description}</p>
                    </div>
                  </td>
                  <td>
                    <span class="category-pill">{post.category}</span>
                  </td>
                  <td>
                    <div class="tags-cluster">
                      {(post.tags || []).slice(0, 3).map((t) => (
                        <span class="tag-badge">#{t}</span>
                      ))}
                      {(post.tags || []).length > 3 && (
                        <span class="tag-badge tag-badge--more">+{(post.tags || []).length - 3}</span>
                      )}
                    </div>
                  </td>
                  <td>
                    <span class={`status-badge ${isPublished ? 'status-badge--published' : 'status-badge--draft'}`}>
                      {post.status || 'Draft'}
                    </span>
                  </td>
                  <td>
                    <span class="date-cell">
                      {post.createdDate ? new Date(post.createdDate).toLocaleDateString() : 'Recent'}
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <div class="row-actions">
                      <a
                        href={`/posts/${post.id}`}
                        target="_blank"
                        rel="noopener"
                        class="action-btn"
                        title="View Live"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                          <polyline points="15 3 21 3 21 9" />
                          <line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                      </a>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- Empty Filter State -->
      <div id="emptySearchState" class="empty-state hidden">
        <p class="empty-state__title">No posts matching your filter</p>
        <p class="empty-state__sub">Try adjusting your keywords or category filters.</p>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Client-side filtering logic
  const searchInput = document.getElementById('postSearchInput') as HTMLInputElement;
  const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
  const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
  const tableRows = document.querySelectorAll<HTMLTableRowElement>('.post-row');
  const emptyState = document.getElementById('emptySearchState') as HTMLDivElement;

  function filterPosts(): void {
    const q = searchInput.value.trim().toLowerCase();
    const selectedCategory = categoryFilter.value;
    const selectedStatus = statusFilter.value;

    let visibleCount = 0;

    tableRows.forEach((row) => {
      const title = row.dataset.title || '';
      const cat = row.dataset.category || '';
      const status = row.dataset.status || '';
      const tags = row.dataset.tags || '';

      const matchesQuery = !q || title.includes(q) || tags.includes(q);
      const matchesCategory = !selectedCategory || cat === selectedCategory;
      const matchesStatus = !selectedStatus || status === selectedStatus;

      if (matchesQuery && matchesCategory && matchesStatus) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      emptyState.classList.remove('hidden');
    } else {
      emptyState.classList.add('hidden');
    }
  }

  searchInput.addEventListener('input', filterPosts);
  categoryFilter.addEventListener('change', filterPosts);
  statusFilter.addEventListener('change', filterPosts);

  // Invalidate cache or load client-side created posts from localStorage
  const localPosts = JSON.parse(localStorage.getItem('verso:custom_posts') || '[]');
  if (localPosts.length > 0) {
    const tbody = document.getElementById('postsTableBody');
    if (tbody) {
      localPosts.forEach((post: any) => {
        const isPublished = (post.status || '').toLowerCase() === 'published';
        const tr = document.createElement('tr');
        tr.className = 'post-row';
        tr.dataset.id = post.id;
        tr.dataset.title = (post.title || '').toLowerCase();
        tr.dataset.category = post.category || '';
        tr.dataset.status = post.status || 'Draft';
        tr.dataset.tags = (post.tags || []).join(' ').toLowerCase();

        tr.innerHTML = `
          <td>
            <div class="thumb-cell">
              ${post.mediaUrl ? `<img src="${post.mediaUrl}" alt="" class="thumb-img" />` : '<div class="thumb-placeholder">★</div>'}
            </div>
          </td>
          <td>
            <div class="post-title-cell">
              <a href="/posts/${post.id}" class="post-title-link">
                ${post.title}
              </a>
              <p class="post-desc-excerpt">${post.description || ''}</p>
            </div>
          </td>
          <td><span class="category-pill">${post.category || 'General'}</span></td>
          <td>
            <div class="tags-cluster">
              ${(post.tags || []).map((t: string) => `<span class="tag-badge">#${t}</span>`).join('')}
            </div>
          </td>
          <td>
            <span class="status-badge ${isPublished ? 'status-badge--published' : 'status-badge--draft'}">
              ${post.status}
            </span>
          </td>
          <td><span class="date-cell">Just now</span></td>
          <td style="text-align: right;">
            <div class="row-actions">
              <a href="/posts/${post.id}" target="_blank" rel="noopener" class="action-btn" title="View Live">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              </a>
            </div>
          </td>
        `;
        tbody.prepend(tr);
      });
    }
  }
</script>

<style>
  .page {
    padding: clamp(24px, 4vw, 56px) 0 80px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .breadcrumb a {
    color: var(--muted);
    transition: color 0.15s ease;
  }

  .breadcrumb a:hover {
    color: var(--text);
  }

  .breadcrumb .sep {
    color: var(--faint);
  }

  .breadcrumb .current {
    color: var(--text);
    font-weight: 500;
  }

  .page-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 32px;
  }

  .page__h1 {
    font-size: clamp(32px, 5vw, 56px);
    margin: 0.15em 0 0;
    line-height: 1.05;
  }

  .page__lede {
    color: var(--muted);
    font-size: 16px;
    margin-top: 10px;
    max-width: 600px;
  }

  .icon-inline {
    width: 16px;
    height: 16px;
    margin-right: 6px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-card__label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 600;
  }

  .stat-card__val {
    font-size: 28px;
    font-weight: 600;
    font-family: 'Spectral', serif;
    color: var(--text);
  }

  .stat-card__val--published {
    color: #2e7d32;
  }

  .stat-card__val--draft {
    color: #e65100;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .search-box {
    position: relative;
    flex: 1;
    min-width: 240px;
    max-width: 440px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--muted);
    pointer-events: none;
  }

  .search-box input {
    width: 100%;
    padding: 10px 14px 10px 38px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .search-box input:focus {
    border-color: var(--accent);
  }

  .toolbar__filters {
    display: flex;
    gap: 10px;
  }

  .toolbar__filters select {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 13px;
    color: var(--text);
    font-family: inherit;
    outline: none;
    cursor: pointer;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    overflow: hidden;
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    text-align: left;
  }

  .data-table th {
    padding: 12px 18px;
    background: var(--chip-bg);
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    border-bottom: 1px solid var(--border-soft);
  }

  .data-table td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--hairline);
    vertical-align: middle;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  .data-table tr:hover td {
    background: var(--chip-bg);
  }

  .thumb-cell {
    width: 52px;
    height: 52px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--border-soft);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--faint);
  }

  .thumb-placeholder svg {
    width: 24px;
    height: 24px;
  }

  .post-title-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
    max-width: 320px;
  }

  .post-title-link {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .post-title-link:hover {
    color: var(--accent);
  }

  .post-desc-excerpt {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-pill {
    display: inline-block;
    padding: 3px 10px;
    background: var(--chip-bg);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
  }

  .tags-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tag-badge {
    font-size: 11px;
    color: var(--muted);
    background: var(--chip-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .tag-badge--more {
    font-weight: 600;
    color: var(--accent);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-badge--published {
    background: rgba(46, 125, 50, 0.12);
    color: #2e7d32;
    border: 1px solid rgba(46, 125, 50, 0.25);
  }

  .status-badge--draft {
    background: rgba(230, 81, 0, 0.12);
    color: #e65100;
    border: 1px solid rgba(230, 81, 0, 0.25);
  }

  .date-cell {
    font-size: 12px;
    color: var(--muted);
  }

  .row-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .action-btn {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--chip-bg);
    color: var(--muted);
    transition: all 0.15s ease;
  }

  .action-btn:hover {
    color: var(--accent);
    background: var(--border-soft);
  }

  .action-btn svg {
    width: 16px;
    height: 16px;
  }

  .empty-state {
    padding: 60px 20px;
    text-align: center;
  }

  .empty-state__title {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--text);
  }

  .empty-state__sub {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
  }

  .hidden {
    display: none !important;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .btn--primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }
</style>
