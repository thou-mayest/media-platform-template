---
import AdSlot from '@/components/AdSlot.astro';
import ExploreForm from '@/components/ExploreForm.astro';
import PostGrid from '@/components/PostGrid.astro';
import Layout from '@/layouts/Layout.astro';
import type { PostFacets, PostSummary } from '@/lib/server/posts';
import { getPostFacets } from '@/lib/server/posts';
import { cleanFilter, parseSort, setNoStore } from '@/lib/server/page';

export const prerender = false;

const category = cleanFilter(Astro.url.searchParams.get('category'), 100);
const tag = cleanFilter(Astro.url.searchParams.get('tag'), 50).toLowerCase();
const sort = parseSort(Astro.url.searchParams.get('sort'));

let facets: PostFacets = { categories: [], tags: [] };
try {
  facets = await getPostFacets();
} catch {
  // Filters are optional; posts are loaded in the browser.
}
setNoStore(Astro.response.headers);

const templatePost: PostSummary = {
  id: '__id__',
  authorId: '',
  title: '__title__',
  description: '__description__',
  mediaUrl: '__media__',
  category: '__category__',
  tags: ['__tag__'],
  status: '',
  createdDate: '',
  updateDate: null,
  publishedAt: '2000-01-01T00:00:00Z',
};

// The query value is lowercased; show the tag's canonical display name from the facets when available.
const displayTag = facets.tags.find((facet) => facet.name.toLowerCase() === tag)?.name ?? tag;
---

<Layout
  title="Explore published work — Verso"
  description="Browse the latest published work in a clean, uninterrupted visual feed."
  canonical={`${Astro.url.origin}/explore`}
>
  <main class="container explore-page">
    <header class="explore-page__header">
      <div class="explore-page__intro">
        <div class="eyebrow">The public index</div>
        <h1 class="h-display">Explore the collection.</h1>
        <p>A quiet, uninterrupted view of work published by artists across the index.</p>
      </div>
      <div class="explore-page__edition" aria-label="Collection details">
        <span>In the archive</span>
        <strong id="total-count">–</strong>
        <span id="total-label">published works</span>
      </div>
    </header>

    <AdSlot />

    <ExploreForm facets={facets} category={category} tag={tag} sort={sort} />

    <div class="collection-head">
      <div>
        <div class="eyebrow">Latest additions</div>
        <h2 class="h-section">Work from the index</h2>
      </div>
      {(category || tag || sort !== 'newest') ? (
        <a href="/explore">View the full collection →</a>
      ) : (
        <span>Newest first</span>
      )}
    </div>

    {(category || tag) && (
      <div class="active-view">
        Showing {category ? category : 'all categories'}{tag ? ` · #${displayTag}` : ''}
      </div>
    )}

    <div id="explore-results" aria-live="polite"></div>
        <div class="load-more" id="load-more" hidden>
          <button class="btn btn-ghost" type="button" id="load-more-button">Load more</button>
        </div>

        <template id="grid-template"><PostGrid posts={[templatePost]} /></template>
        <template id="empty-template"><PostGrid posts={[]} /></template>
        <template id="error-template">
          <div class="error-state" role="alert">The collection could not be loaded. Please try again shortly.</div>
        </template>
      </main>
    </Layout>

    <script>
      import type { PagedPosts, PostSummary } from '@/lib/server/posts';

      const apiBaseUrl = (import.meta.env.PUBLIC_API_BASE_URL || 'https://localhost:7021').replace(/\/$/, '');
      const results = document.getElementById('explore-results')!;
      const loadMore = document.getElementById('load-more')!;
      const loadMoreButton = document.getElementById('load-more-button') as HTMLButtonElement;
      const totalCount = document.getElementById('total-count')!;
      const totalLabel = document.getElementById('total-label')!;
      const template = (id: string) =>
        (document.getElementById(id) as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment;

      const params = new URLSearchParams(location.search);
      let page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);
      let grid: HTMLElement | null = null;
      let cardTemplate: HTMLElement;

      function buildCard(post: PostSummary): HTMLElement {
        const card = cardTemplate.cloneNode(true) as HTMLElement;
        const media = card.querySelector<HTMLAnchorElement>('.post-card__media')!;
        media.href = `/posts/${post.id}`;
        media.setAttribute('aria-label', `View ${post.title}`);
        const img = media.querySelector('img');
        if (post.mediaUrl && img) {
          img.src = post.mediaUrl;
        } else if (img) {
          const placeholder = document.createElement('span');
          placeholder.className = 'post-card__placeholder';
          placeholder.setAttribute('aria-hidden', 'true');
          for (const attr of Array.from(img.attributes))
            if (attr.name.startsWith('data-astro-cid')) placeholder.setAttribute(attr.name, attr.value);
          img.replaceWith(placeholder);
        }

        const category = card.querySelector<HTMLAnchorElement>('.post-card__overline a')!;
        category.href = `/explore?category=${encodeURIComponent(post.category)}`;
        category.textContent = post.category;

        const time = card.querySelector('time');
        if (time && post.publishedAt) {
          time.dateTime = post.publishedAt;
          time.textContent = new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric' })
            .format(new Date(post.publishedAt));
        } else {
          time?.remove();
        }

        const title = card.querySelector<HTMLAnchorElement>('h3 a')!;
        title.href = `/posts/${post.id}`;
        title.textContent = post.title;

        const description = card.querySelector('.post-card__body > p');
        if (post.description && description) description.textContent = post.description;
        else description?.remove();

        const tags = card.querySelector('.post-card__tags');
        const tagTemplate = tags?.querySelector<HTMLAnchorElement>('a');
        if (tags && tagTemplate) {
          const visible = post.tags.slice(0, 3);
          if (visible.length === 0) {
            tags.remove();
          } else {
            tags.replaceChildren(...visible.map((tag) => {
              const link = tagTemplate.cloneNode(true) as HTMLAnchorElement;
              link.href = `/tags/${encodeURIComponent(tag)}`;
              link.textContent = `#${tag}`;
              return link;
            }));
          }
        }

        return card;
      }

      async function load() {
        loadMoreButton.disabled = true;
        const query = new URLSearchParams(location.search);
        query.set('page', String(page));

        try {
          query.set('pageSize', '20');
          const response = await fetch(`${apiBaseUrl}/api/posts?${query}`, { headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error(String(response.status));
          const data = (await response.json()) as PagedPosts;

          totalCount.textContent = String(data.totalCount);
          totalLabel.textContent = data.totalCount === 1 ? 'published work' : 'published works';

          if (!grid) {
            if (data.items.length === 0) {
              results.replaceChildren(template('empty-template'));
              return;
            }
            const fragment = template('grid-template');
            grid = fragment.querySelector<HTMLElement>('.post-grid')!;
            cardTemplate = grid.querySelector<HTMLElement>('.post-card')!;
            grid.replaceChildren();
            results.replaceChildren(fragment);
          }

          grid.append(...data.items.map(buildCard));
          loadMore.hidden = data.page >= data.totalPages;
          page = data.page + 1;
        } catch {
          if (!grid) results.replaceChildren(template('error-template'));
        } finally {
          loadMoreButton.disabled = false;
        }
      }

      loadMoreButton.addEventListener('click', load);
      load();
    </script>

<style>
  .explore-page {
    padding: clamp(42px, 6vw, 78px) 0 clamp(64px, 8vw, 110px);
  }
  .explore-page__header {
    align-items: start;
    border-bottom: 1px solid var(--border-soft);
    display: grid;
    gap: clamp(34px, 8vw, 130px);
    grid-template-columns: minmax(0, 1fr) auto;
    margin-bottom: clamp(28px, 4vw, 46px);
    padding-bottom: clamp(36px, 5vw, 64px);
  }
  .explore-page h1 {
    font-size: clamp(50px, 8.5vw, 116px);
    margin-top: 0.15em;
    max-width: 10ch;
  }
  .explore-page__intro p {
    color: var(--muted);
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.65;
    margin: 26px 0 0;
    max-width: 48ch;
  }
  .explore-page__edition {
    border-left: 1px solid var(--border-soft);
    display: grid;
    min-width: 150px;
    padding: 8px 0 6px clamp(22px, 3vw, 42px);
  }
  .explore-page__edition strong {
    font-family: 'Spectral', serif;
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 300;
    line-height: 1;
    margin: 10px 0 5px;
  }
  .explore-page__edition span,
  .collection-head > span,
  .collection-head > a {
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .collection-head {
    align-items: end;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    margin-top: clamp(50px, 7vw, 90px);
    padding-bottom: 26px;
  }
  .collection-head h2 {
    font-size: clamp(30px, 4vw, 50px);
    margin-top: 8px;
  }
  .collection-head > a:hover { color: var(--accent); }
  .active-view {
    background: var(--surface);
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.08em;
    margin-bottom: 28px;
    padding: 14px 18px;
    text-transform: uppercase;
  }
  .error-state {
    border: 1px solid var(--border-soft);
    color: var(--muted);
    padding: 42px;
    text-align: center;
  }
  @media (max-width: 760px) {
    .explore-page__header { grid-template-columns: 1fr; }
    .explore-page__edition {
      border-left: 0;
      border-top: 1px solid var(--border-soft);
      grid-template-columns: auto 1fr auto;
      align-items: baseline;
      padding: 22px 0 0;
    }
    .explore-page__edition strong {
      font-size: 42px;
      margin: 0;
      text-align: center;
    }
    .collection-head { align-items: start; }
  }
</style>
