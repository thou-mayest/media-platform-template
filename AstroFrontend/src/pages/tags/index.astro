---
import Layout from '@/layouts/Layout.astro';
import type { PostFacet } from '@/lib/server/posts';
import { getPostFacets } from '@/lib/server/posts';
import { cleanFilter, setCollectionCache, setNoStore } from '@/lib/server/page';

let tags: PostFacet[] = [];
let error = '';
const query = cleanFilter(Astro.url.searchParams.get('q'), 50);

try {
  const facets = await getPostFacets();
  tags = [...facets.tags].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
  setCollectionCache(Astro.response.headers);
} catch {
  error = 'The tag index could not be loaded. Please try again shortly.';
  Astro.response.status = 502;
  setNoStore(Astro.response.headers);
}

const totalTaggedWorks = tags.reduce((total, tag) => total + tag.count, 0);
const normalizedQuery = query.toLocaleLowerCase();
const visibleTags = normalizedQuery
  ? tags.filter((tag) => tag.name.toLocaleLowerCase().includes(normalizedQuery))
  : tags;
---

<Layout
  title="Tags — Verso"
  description="Explore published work through the themes, materials and ideas that connect the Verso index."
  canonical={`${Astro.url.origin}/tags`}
>
  <main class="container tags-page">
    <header class="tags-hero">
      <div>
        <div class="eyebrow">Browse the index</div>
        <h1 class="h-display">Follow an idea.</h1>
        <p>
          Tags connect work across artists and disciplines. Choose a thread and see where it leads.
        </p>
      </div>
      <div class="tags-hero__summary" aria-label="Tag index summary">
        <div>
          <strong>{tags.length}</strong>
          <span>{tags.length === 1 ? 'active tag' : 'active tags'}</span>
        </div>
        <div>
          <strong>{totalTaggedWorks}</strong>
          <span>tagged works</span>
        </div>
      </div>
    </header>

    {error ? (
      <div class="error-state" role="alert">{error}</div>
    ) : tags.length > 0 ? (
      <section class="tag-index" aria-labelledby="tag-index-title">
        <header class="tag-index__head">
          <div>
            <div class="eyebrow">All tags</div>
            <h2 id="tag-index-title" class="h-section">Ways into the collection</h2>
          </div>
          <span>Ordered by activity</span>
        </header>

        <div class="search-panel">
          <span class="search-panel__decor" aria-hidden="true"></span>
          <div class="search-panel__intro">
            <span class="search-panel__number">01</span>
            <div>
              <div class="search-panel__kicker">Curated discovery</div>
              <h3>What are you drawn to?</h3>
              <p>Search a mood, material, subject or visual language.</p>
            </div>
          </div>

          <form
            class="tag-search"
            action="/tags"
            method="get"
            role="search"
            data-tags={JSON.stringify(tags.map(({ name, count }) => ({ name, count })))}
          >
            <label class="sr-only" for="tag-query">Search tags</label>
            <div class="tag-search__field">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3"></path>
              </svg>
              <input
                id="tag-query"
                name="q"
                type="search"
                value={query}
                placeholder="Search the tag archive"
                autocomplete="off"
                role="combobox"
                aria-autocomplete="list"
                aria-controls="tag-suggestions"
                aria-expanded="false"
              />
              {query && <a class="tag-search__clear" href="/tags" aria-label="Clear tag search">Clear</a>}
              <button type="submit" aria-label="Find tags">
                <span>Search</span>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </button>
            </div>
            <ul id="tag-suggestions" class="tag-suggest" role="listbox" aria-label="Matching tags" hidden></ul>
          </form>

          <div class="search-panel__suggestions">
            <span>Trending</span>
            {tags.slice(0, 4).map((tag) => (
              <a href={`/tags?q=${encodeURIComponent(tag.name)}`}>#{tag.name}</a>
            ))}
          </div>
        </div>

        <div class="tag-results" aria-live="polite">
          <p>
            <strong>{visibleTags.length}</strong> {visibleTags.length === 1 ? 'tag' : 'tags'}
            {query && <> matching “{query}”</>}
          </p>
        </div>

        {visibleTags.length > 0 ? (
          <div class="tag-grid">
            {visibleTags.map((tag, index) => (
              <a class:list={['tag-card', { 'tag-card--featured': index < 2 }]} href={`/tags/${encodeURIComponent(tag.name.toLowerCase())}`}>
                <span class="tag-card__number">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>#{tag.name}</h3>
                  <p>{tag.count} published {tag.count === 1 ? 'work' : 'works'}</p>
                </div>
                <span class="tag-card__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        ) : (
          <div class="no-results">
            <span aria-hidden="true">#</span>
            <div>
              <h3>No tags found</h3>
              <p>Try a shorter word or browse the complete tag index.</p>
            </div>
            <a class="btn btn-ghost" href="/tags">View all tags</a>
          </div>
        )}
      </section>
    ) : (
      <div class="empty-state">
        <h2>Tags will appear here.</h2>
        <p>The index has no tagged work yet.</p>
        <a class="btn btn-ghost" href="/explore">Explore all works</a>
      </div>
    )}
  </main>
</Layout>

<script>
  type TagOption = { name: string; count: number };

  const form = document.querySelector<HTMLFormElement>('form.tag-search[data-tags]');
  const input = document.getElementById('tag-query') as HTMLInputElement | null;
  const list = document.getElementById('tag-suggestions') as HTMLUListElement | null;

  if (form && input && list) {
    let tags: TagOption[] = [];
    try {
      tags = JSON.parse(form.dataset.tags || '[]');
    } catch {
      tags = [];
    }

    const MAX_RESULTS = 8;
    let matches: TagOption[] = [];
    let activeIndex = -1;

    const tagHref = (name: string) => `/tags/${encodeURIComponent(name.toLowerCase())}`;

    function findMatches(raw: string): TagOption[] {
      const q = raw.trim().replace(/^#+/, '').toLocaleLowerCase();
      if (!q) return [];
      const prefix: TagOption[] = [];
      const contains: TagOption[] = [];
      for (const tag of tags) {
        const name = tag.name.toLocaleLowerCase();
        if (name.startsWith(q)) prefix.push(tag);
        else if (name.includes(q)) contains.push(tag);
      }
      // `tags` is already sorted by count desc, so each bucket keeps that order.
      return [...prefix, ...contains].slice(0, MAX_RESULTS);
    }

    function close(): void {
      list!.hidden = true;
      list!.innerHTML = '';
      input!.setAttribute('aria-expanded', 'false');
      input!.removeAttribute('aria-activedescendant');
      matches = [];
      activeIndex = -1;
    }

    function setActive(index: number): void {
      const items = list!.querySelectorAll<HTMLLIElement>('.tag-suggest__item');
      items.forEach((item, i) => {
        const active = i === index;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
        if (active) item.scrollIntoView({ block: 'nearest' });
      });
      activeIndex = index;
      if (index >= 0) input!.setAttribute('aria-activedescendant', `tag-suggest-${index}`);
      else input!.removeAttribute('aria-activedescendant');
    }

    function render(): void {
      const q = input!.value.trim().replace(/^#+/, '');
      matches = findMatches(q);
      list!.innerHTML = '';
      activeIndex = -1;

      if (matches.length === 0) {
        close();
        return;
      }

      matches.forEach((tag, i) => {
        const li = document.createElement('li');
        li.id = `tag-suggest-${i}`;
        li.className = 'tag-suggest__item';
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');

        const name = document.createElement('span');
        name.className = 'tag-suggest__name';
        const start = tag.name.toLocaleLowerCase().indexOf(q.toLocaleLowerCase());
        name.append('#');
        if (start >= 0) {
          name.append(tag.name.slice(0, start));
          const mark = document.createElement('mark');
          mark.textContent = tag.name.slice(start, start + q.length);
          name.append(mark, tag.name.slice(start + q.length));
        } else {
          name.append(tag.name);
        }

        const count = document.createElement('span');
        count.className = 'tag-suggest__count';
        count.textContent = `${tag.count} ${tag.count === 1 ? 'work' : 'works'}`;

        li.append(name, count);
        // mousedown (not click) so selection happens before the input blurs.
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          select(i);
        });
        li.addEventListener('mousemove', () => {
          if (activeIndex !== i) setActive(i);
        });
        list!.appendChild(li);
      });

      list!.hidden = false;
      input!.setAttribute('aria-expanded', 'true');
    }

    function select(index: number): void {
      const tag = matches[index];
      if (!tag) return;
      input!.value = tag.name;
      close();
      window.location.href = tagHref(tag.name);
    }

    input.addEventListener('input', render);
    input.addEventListener('focus', () => {
      if (input.value.trim()) render();
    });
    input.addEventListener('blur', close);

    input.addEventListener('keydown', (e) => {
      if (list.hidden) {
        if (e.key === 'ArrowDown' && input.value.trim()) {
          e.preventDefault();
          render();
          if (matches.length) setActive(0);
        }
        return;
      }

      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          setActive((activeIndex + 1) % matches.length);
          break;
        case 'ArrowUp':
          e.preventDefault();
          setActive(activeIndex <= 0 ? matches.length - 1 : activeIndex - 1);
          break;
        case 'Enter':
          // With no highlighted option, fall through to the normal search submit.
          if (activeIndex >= 0) {
            e.preventDefault();
            select(activeIndex);
          }
          break;
        case 'Escape':
          e.preventDefault();
          close();
          break;
        case 'Tab':
          close();
          break;
      }
    });
  }
</script>

<style>
  .tags-page {
    padding: clamp(48px, 7vw, 92px) 0 clamp(70px, 9vw, 120px);
  }
  .tags-hero {
    align-items: end;
    border-bottom: 1px solid var(--border-soft);
    display: grid;
    gap: clamp(42px, 8vw, 130px);
    grid-template-columns: minmax(0, 1fr) auto;
    padding-bottom: clamp(42px, 6vw, 72px);
  }
  .tags-hero h1 {
    font-size: clamp(52px, 9vw, 122px);
    margin-top: 0.16em;
    max-width: 9ch;
  }
  .tags-hero p {
    color: var(--muted);
    font-size: clamp(15px, 1.35vw, 18px);
    line-height: 1.65;
    margin: 28px 0 0;
    max-width: 48ch;
  }
  .tags-hero__summary {
    border-left: 1px solid var(--border-soft);
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, minmax(110px, 1fr));
    padding-left: clamp(24px, 4vw, 56px);
  }
  .tags-hero__summary > div { display: grid; gap: 5px; }
  .tags-hero__summary strong {
    font-family: 'Spectral', serif;
    font-size: clamp(40px, 5vw, 66px);
    font-weight: 300;
    line-height: 1;
  }
  .tags-hero__summary span,
  .tag-index__head > span {
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tag-index { margin-top: clamp(54px, 7vw, 90px); }
  .tag-index__head {
    align-items: end;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  .tag-index__head h2 {
    font-size: clamp(29px, 4vw, 48px);
    margin-top: 8px;
  }
  .search-panel {
    background:
      radial-gradient(circle at 88% 12%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 30%),
      var(--surface);
    border: 1px solid var(--border-soft);
    display: grid;
    gap: clamp(24px, 4vw, 46px);
    margin-bottom: 22px;
    padding: clamp(26px, 4vw, 52px);
    position: relative;
    z-index: 2;
  }
  /* Decoration is clipped in its own layer so the panel itself can let the
     autocomplete dropdown overflow. */
  .search-panel__decor {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
  }
  .search-panel__decor::after {
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    content: '';
    height: 180px;
    opacity: 0.65;
    pointer-events: none;
    position: absolute;
    right: -92px;
    top: -100px;
    width: 180px;
  }
  .search-panel__intro {
    display: grid;
    gap: clamp(18px, 3vw, 34px);
    grid-template-columns: auto 1fr;
  }
  .search-panel__number {
    color: var(--accent);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    padding-top: 8px;
  }
  .search-panel__kicker,
  .search-panel__suggestions > span {
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .search-panel__intro h3 {
    font-family: 'Spectral', serif;
    font-size: clamp(28px, 3.6vw, 46px);
    font-weight: 400;
    line-height: 1.05;
    margin: 10px 0 0;
  }
  .search-panel__intro p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
    margin: 10px 0 0;
  }
  .sr-only {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
  .tag-search__field {
    align-items: center;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--muted);
    display: flex;
    gap: clamp(12px, 2vw, 20px);
    min-height: clamp(66px, 7vw, 82px);
    padding: 8px 9px 8px clamp(16px, 2.5vw, 28px);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .tag-search__field svg { flex: 0 0 auto; }
  .tag-search input {
    background: transparent;
    border: 0;
    color: var(--text);
    font-family: 'Spectral', serif;
    font-size: clamp(20px, 2.5vw, 30px);
    font-style: italic;
    min-width: 0;
    outline: 0;
    width: 100%;
  }
  .tag-search__field:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .tag-search button {
    align-items: center;
    align-self: stretch;
    background: var(--ink);
    border: 0;
    color: var(--on-ink);
    cursor: pointer;
    display: inline-flex;
    flex: 0 0 auto;
    gap: 18px;
    justify-content: center;
    min-width: 148px;
    padding: 0 22px;
    transition: background-color 0.2s, transform 0.2s;
  }
  .tag-search button span {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .tag-search button:hover {
    background: var(--accent);
    transform: translateX(-2px);
  }
  .tag-search__clear {
    color: var(--muted);
    flex: 0 0 auto;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 10px 2px;
    text-transform: uppercase;
  }
  .tag-search__clear:hover { color: var(--accent); }
  .tag-search { position: relative; }
  .tag-suggest {
    background: var(--bg);
    border: 1px solid var(--border);
    box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--ink) 35%, transparent);
    left: 0;
    list-style: none;
    margin: 6px 0 0;
    max-height: 340px;
    overflow-y: auto;
    padding: 6px 0;
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 10;
  }
  .tag-suggest[hidden] { display: none; }
  .tag-suggest__item {
    align-items: baseline;
    cursor: pointer;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding: 11px clamp(16px, 2.5vw, 28px);
  }
  .tag-suggest__item.is-active {
    background: var(--ink);
    color: var(--on-ink);
  }
  .tag-suggest__name {
    font-family: 'Spectral', serif;
    font-size: 19px;
    font-style: italic;
    overflow-wrap: anywhere;
  }
  .tag-suggest__name mark {
    background: transparent;
    color: var(--accent);
  }
  .tag-suggest__count {
    color: var(--muted);
    flex: 0 0 auto;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tag-suggest__item.is-active .tag-suggest__count { color: var(--on-ink); opacity: 0.7; }
  .search-panel__suggestions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .search-panel__suggestions > span { margin-right: 6px; }
  .search-panel__suggestions a {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 11px;
    padding: 8px 13px;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .search-panel__suggestions a:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-ink);
  }
  .tag-results {
    align-items: center;
    display: flex;
    min-height: 44px;
  }
  .tag-results p {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }
  .tag-results strong { color: var(--text); }
  .tag-grid {
    border-left: 1px solid var(--border-soft);
    border-top: 1px solid var(--border-soft);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .tag-card {
    align-items: start;
    border-bottom: 1px solid var(--border-soft);
    border-right: 1px solid var(--border-soft);
    display: grid;
    gap: 18px;
    grid-template-columns: auto 1fr auto;
    min-height: 190px;
    padding: clamp(22px, 3vw, 36px);
    transition: background-color 0.2s, color 0.2s;
  }
  .tag-card--featured { background: var(--surface); }
  .tag-card:hover {
    background: var(--ink);
    color: var(--on-ink);
  }
  .tag-card__number {
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .tag-card h3 {
    font-family: 'Spectral', serif;
    font-size: clamp(25px, 3vw, 38px);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    margin: 34px 0 0;
    overflow-wrap: anywhere;
  }
  .tag-card p {
    color: var(--muted);
    font-size: 11px;
    margin: 12px 0 0;
  }
  .tag-card:hover p,
  .tag-card:hover .tag-card__number { color: var(--on-ink); opacity: 0.7; }
  .tag-card__arrow { color: var(--accent); font-size: 18px; }
  .error-state,
  .empty-state,
  .no-results {
    border: 1px solid var(--border-soft);
    margin-top: 48px;
    padding: clamp(42px, 7vw, 84px);
    text-align: center;
  }
  .error-state { color: var(--muted); }
  .empty-state h2 { font-family: 'Spectral', serif; font-size: 34px; font-weight: 400; margin: 0; }
  .empty-state p { color: var(--muted); margin: 14px 0 26px; }
  .no-results {
    align-items: center;
    display: grid;
    gap: 24px;
    grid-template-columns: auto 1fr auto;
    margin-top: 0;
    text-align: left;
  }
  .no-results > span {
    color: var(--accent);
    font-family: 'Spectral', serif;
    font-size: clamp(50px, 7vw, 80px);
    font-style: italic;
  }
  .no-results h3 {
    font-family: 'Spectral', serif;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 400;
    margin: 0;
  }
  .no-results p { color: var(--muted); margin: 8px 0 0; }
  @media (max-width: 900px) {
    .tags-hero { grid-template-columns: 1fr; }
    .tags-hero__summary { border-left: 0; border-top: 1px solid var(--border-soft); padding: 24px 0 0; }
    .tag-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .tag-grid { grid-template-columns: 1fr; }
    .tag-card { min-height: 150px; }
    .tag-index__head { align-items: start; flex-direction: column; }
    .search-panel { margin-inline: -2vw; }
    .tag-search__field { flex-wrap: wrap; padding: 14px; }
    .tag-search input { flex: 1 1 calc(100% - 46px); }
    .tag-search button { min-height: 50px; order: 4; width: 100%; }
    .tag-search__clear { margin-left: 36px; }
    .search-panel__suggestions > span { flex-basis: 100%; }
    .no-results { grid-template-columns: 1fr; text-align: center; }
    .no-results > span { display: none; }
  }
</style>
